/* 全局样式（对应网页版 style.css 开头的设计规范与「通用组件」）：纸张底色 + 墨色文字 + T 蓝 / F 橙，标题用宋体，红色印章。
   --route-* 是 color-mix 的预计算版本，见 core/color.js */
page {
  --bg: #f6f1e7; --paper-2: #efe7d8; --card: #fffdf8; --ink: #24223a; --ink-2: #4e4b63; --muted: #8b8698; --line: #e5ddcd;
  --brand: #5a48c2; --brand-soft: #efecfa; --t: #3f86de; --f: #ef7550; --gold: #e9b44c; --seal: #c8372d;
  --good: #3aa676; --bad: #e0823d; --accent: #5a48c2; --radius: 16px;
  --shadow: 0 1px 2px rgba(36,34,58,.04), 0 8px 24px rgba(36,34,58,.06);
  --serif: "Songti SC", "Noto Serif SC", "Source Han Serif SC", "STSong", serif;
  --route: #5a48c2; --route-6: rgb(246,245,252); --route-8: rgb(242,240,250); --route-12: rgb(235,233,248); --route-15: rgb(231,228,246);
  --route-45: rgb(181,172,227); --route-55: rgb(167,157,222); --route-a25: rgba(90,72,194,.25); --route-a50: rgba(90,72,194,.5); --route-a70: rgba(90,72,194,.7);
  background: var(--bg); color: var(--ink); font-size: 15px; line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}
view, scroll-view, image, text { box-sizing: border-box; }
.wrap { padding: 12px 14px 60px; }
.muted { color: var(--muted); }
.small { font-size: 13px; }
.center { text-align: center; }
.b { font-weight: 700; }
.h1 { font-size: 28px; font-weight: 700; line-height: 1.3; margin: 8px 0 18px; }
.h2 { font-size: 20px; font-weight: 700; margin: 4px 0; }
.h3 { font-size: 17px; font-weight: 700; margin: 0 0 8px; }
.p { margin: 10px 0; line-height: 1.75; }
.ul .li, .ol .li { position: relative; line-height: 1.85; margin: 2px 0; }
.ul .li { padding-left: 16px; }
.ul .li::before { content: "•"; position: absolute; left: 3px; color: var(--muted); }

.paper { background-color: var(--bg); background-image: radial-gradient(rgba(36,34,58,.07) 1px, transparent 1.3px); background-size: 22px 22px; min-height: 100vh; }
.card { background: var(--card); border-radius: var(--radius); padding: 16px 18px; margin: 12px 0; border: 1px solid var(--line); box-shadow: var(--shadow); }
.btn { display: inline-block; background: var(--route); color: #fff; padding: 11px 20px; border-radius: 999px; font-size: 15px; line-height: 1.35; text-align: center; transition: transform .1s, opacity .2s; }
.btn.ghost { background: transparent; color: var(--route); border: 1.5px solid var(--route); }
.btn.plain { background: var(--paper-2); color: var(--ink); }
.btn.light { background: #fff; color: var(--ink); }
.btn.link { background: transparent; color: rgba(255,255,255,.85); text-decoration: underline; padding-left: 6px; padding-right: 6px; }
.btn.sm { padding: 6px 14px; font-size: 13px; }
.btn.disabled { opacity: .4; }
.pressed { transform: scale(.97); opacity: .9; }
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
.row.center { justify-content: center; }
.topbar { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.back { color: var(--muted); font-size: 14px; padding: 6px 0; }

.feedback { border-radius: var(--radius); padding: 12px 16px; margin: 12px 0; line-height: 1.65; animation: fadein .35s; color: var(--ink); }
.feedback.good { background: #e7f5ee; border-left: 4px solid var(--good); }
.feedback.bad { background: #fcefe3; border-left: 4px solid var(--bad); }
.feedback.info { background: #eef2fb; border-left: 4px solid var(--route); }
.feedback .ft { font-weight: 600; margin-bottom: 4px; }
@keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; } }

.stars { color: #f2b632; letter-spacing: 2px; font-size: 18px; white-space: nowrap; }
.stars .off, .big-stars .off { color: #ddd; }
.result { text-align: center; }
.big-stars { font-size: 40px; color: #f2b632; letter-spacing: 6px; }
.takeaway .h3 { margin: 0 0 8px; }
.tag { display: inline-block; font-size: 12px; color: var(--accent); }
.coming-chip { border: 1.5px dashed #d8d1c4; border-radius: 14px; padding: 12px 14px; color: var(--muted); }
.coming-chip .b { display: block; color: var(--ink); opacity: .7; margin-bottom: 2px; }
.coming-chip .s { font-size: 13px; }
.coming-chip .soon { display: inline-block; margin-top: 6px; font-size: 11px; padding: 1px 8px; border-radius: 999px; background: #efeae0; }
.portrait { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; border: 3px solid var(--route); background: #e8edf3; flex-shrink: 0; }
.portrait image { width: 100%; height: 100%; display: block; }
.portrait.big { width: 90px; height: 90px; }

/* 章节序号（壹贰叁…）与印章 */
.sec-no { flex-shrink: 0; width: 28px; height: 28px; border-radius: 7px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 14px;
  font-family: var(--serif); background: linear-gradient(135deg, var(--t), var(--brand) 55%, var(--f)); box-shadow: 0 3px 8px rgba(90,72,194,.25); transform: rotate(-4deg); }
.seal { width: 42px; height: 42px; border-radius: 7px; background: var(--seal); color: #fff; font-family: var(--serif); font-weight: 900; font-size: 14px; line-height: 1.05;
  display: flex; flex-direction: column; align-items: center; justify-content: center; transform: rotate(-6deg);
  box-shadow: inset 0 0 0 2px rgba(255,255,255,.65), inset 0 0 0 4px var(--seal), 0 4px 10px rgba(0,0,0,.25); }
