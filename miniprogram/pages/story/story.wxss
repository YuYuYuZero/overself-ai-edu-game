@import "../../templates/stage.wxss";

.root { min-height: 100vh; background: #222; }

/* 舞台外的页面（章首、复盘、结局） */
.page-bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; filter: blur(5px) brightness(.85); transform: scale(1.05); }
.page-shade { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.15); }
.page-scroll { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; }
.page { position: relative; padding-left: 14px; padding-right: 14px; }
.page .card { background: rgba(255,255,255,.94); }
.page-bar { position: fixed; left: 10px; z-index: 20; display: flex; align-items: center; gap: 6px; }
.page-prog { position: fixed; left: 10px; right: 10px; z-index: 20; }
.page-prog .prog { margin-top: 0; }

.chapter-intro { text-align: center; background: rgba(255,255,255,.9); border-radius: 20px; padding: 28px 18px; margin-top: 10px; }
.goal { text-align: left; background: #fff; border-radius: 14px; padding: 12px 16px; line-height: 1.7; margin-bottom: 10px; }
.goal-row { display: flex; gap: 12px; align-items: center; margin: 8px 0; }
.goal-txt { flex: 1; min-width: 0; }
.btn.wide { min-width: 160px; margin-top: 6px; }
.card-head { display: flex; gap: 12px; align-items: center; margin-bottom: 8px; }
.summary { font-weight: 600; color: var(--ink); }
.ol { margin-top: 8px; }
.ending .h1 { font-size: 30px; margin: 6px 0; }
.ending-pair { display: flex; gap: 20px; justify-content: center; margin-top: 14px; }
.reveal { background: linear-gradient(135deg, #fffaf0, #f6f0ff) !important; border: 1px dashed #c9bdf0; }
.closing { line-height: 1.9; }
.end-btns { display: flex; flex-direction: column; align-items: stretch; gap: 10px; margin-top: 8px; }

/* 转场 */
.interstitial, .title-card { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 50; display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center; padding: 30px; animation: fadein .6s; }
.interstitial .it { font-size: 34px; letter-spacing: 10px; font-weight: 700; }
.interstitial .is { margin-top: 16px; font-size: 15px; line-height: 1.8; max-width: 420px; opacity: .85; }
.mirror-it { background: linear-gradient(90deg, #4a8fe0, #f07c5a); color: #fff; animation: fadein .6s, mirrorflip 1.2s ease; }
@keyframes mirrorflip { 0% { transform: scaleX(0); } 60% { transform: scaleX(1.03); } 100% { transform: scaleX(1); } }
.rewind-it { background: #222; color: #f2c94c; }
.title-it { background: #0d0d12; color: #f2f0ea; }
.title-card { background: #000; color: #f2f0ea; font-size: 20px; letter-spacing: 4px; line-height: 2; transition: opacity .5s; }
.title-card .tt { max-width: 640px; animation: fadein 1.2s ease; }
.title-card.out { opacity: 0; }

/* 目录 */
.toc { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 80; background: rgba(10,10,20,.62); display: flex; align-items: center; justify-content: center; }
.toc-card { background: #fff; border-radius: 18px; width: 94%; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.4); color: var(--ink); }
.toc-head { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px 8px; }
.toc-name { font-size: 18px; }
.toc-pov { display: flex; gap: 8px; align-items: center; padding: 4px 16px 10px; border-bottom: 1px solid var(--line); flex-wrap: wrap; }
.toc-pov-btn { display: flex; align-items: center; gap: 6px; border: 2px solid #ddd; background: #fff; border-radius: 999px; padding: 2px 10px 2px 2px; font-size: 13px; color: #555; }
.toc-pov-btn.on { font-weight: 600; }
.pav-round { width: 28px; height: 28px; border-radius: 50%; overflow: hidden; background: #f3eee8; }
.pav-round image { width: 100%; height: 100%; display: block; }
.toc-list { height: 54vh; padding: 0 10px; box-sizing: border-box; }
.toc-row { display: flex; gap: 10px; padding: 10px 6px; border-radius: 12px; align-items: center; border-bottom: 1px dashed var(--line); }
.toc-row.cur { background: #f5f2ff; }
.toc-thumb { flex: 0 0 76px; width: 76px; height: 43px; border-radius: 8px; background: #222; }
.toc-info { flex: 1; min-width: 0; }
.toc-title { font-weight: 600; font-size: 15px; }
.toc-now { margin-left: 8px; font-size: 11px; color: #fff; background: #6b5bd2; border-radius: 999px; padding: 1px 8px; }
.toc-chips { display: flex; gap: 6px; margin-top: 6px; flex-wrap: wrap; }
.toc-chip { border: 1px solid #ccc; background: #fff; border-radius: 999px; padding: 3px 12px; font-size: 13px; color: #444; }
.toc-chip.seen { color: #2e8b57; border-color: #9fd3b4; }
.toc-chip.here { background: #6b5bd2; color: #fff; border-color: #6b5bd2; }
.toc-note { padding: 8px 16px 14px; line-height: 1.6; }

/* 横屏：舞台外页面收窄居中；目录卡片限高 */
.root.land .page { max-width: 640px; margin: 0 auto; }
.root.land .chapter-intro { padding: 20px 18px; }
.root.land .toc-card { width: 72%; }
.root.land .toc-list { max-height: calc(100vh - 170px); }
.root.land .interstitial .it { font-size: 28px; }
.root.land .title-card { font-size: 18px; }
