/* 首页（网页版 style.css「首页 v3」手机竖屏版） */
.hero { position: relative; overflow: hidden; border-radius: 0 0 24px 24px; padding: 0 22px; color: #fff; box-shadow: 0 18px 50px rgba(30,25,60,.25); }
.hero-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.hero-shade { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: linear-gradient(180deg, rgba(27,22,62,.94) 0%, rgba(36,28,84,.78) 60%, rgba(36,28,84,.3) 100%); }
.hero-text { position: relative; z-index: 2; }
.brand { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
.brand .seal { margin-left: 2px; }
.brand-logo { width: 48px; height: 48px; border-radius: 12px; box-shadow: 0 6px 18px rgba(0,0,0,.3); }
.brand-en { font-size: 15px; font-weight: 700; letter-spacing: 3px; color: #d9cdfa; }
.hero-h1 { font-family: var(--serif); font-size: 34px; line-height: 1.15; font-weight: 900; margin: 0 0 14px; letter-spacing: 2px; }
.grad { background: linear-gradient(90deg, #a9d1ff, #d9c4ff 50%, #ffc2a8); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-lead { font-size: 21px; font-weight: 700; margin: 0 0 12px; white-space: pre-wrap; line-height: 1.45; }
.hero-sub { font-size: 14px; line-height: 1.85; margin: 0 0 16px; color: rgba(255,255,255,.82); }
.hero-type { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 14px; padding: 4px 14px 4px 4px; border-radius: 999px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); font-size: 14px; }
.ht-av { width: 32px; height: 32px; border-radius: 50%; overflow: hidden; }
.ht-av image { width: 100%; height: 100%; display: block; }
.ht-go { opacity: .7; font-size: 18px; }
.btn.hero-main { background: linear-gradient(90deg, var(--t), var(--brand) 55%, var(--f)); font-weight: 700; padding: 12px 24px; box-shadow: 0 8px 22px rgba(90,72,194,.45); }
.hero-note { margin-top: 10px; font-size: 12px; color: rgba(255,255,255,.65); }
.gold { color: #f2c14e; letter-spacing: 2px; }
.hero-cta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.hero-chars { position: relative; z-index: 1; height: 200px; display: flex; justify-content: center; align-items: flex-end; margin-top: 4px; overflow: visible; }
.hero-char { width: 158px; height: 300px; margin: 0 -10px; transform: translateY(26%); filter: drop-shadow(0 10px 18px rgba(0,0,0,.35)); flex-shrink: 0; }

.home-sec { margin-top: 30px; }
.sec-title { font-family: var(--serif); font-size: 20px; font-weight: 900; margin: 0 0 12px; display: flex; align-items: center; gap: 10px; letter-spacing: 1px; }
.note { margin-top: 10px; line-height: 1.7; }
.foot { margin-top: 36px; line-height: 1.7; }

.loop-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.loop-grid .loop-step { width: 48.5%; }
.loop-step { background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; margin-bottom: 10px; box-shadow: var(--shadow); }
.ls-t { font-size: 16px; font-weight: 700; margin: 8px 0 4px; }
.loop-n { width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700;
  background: linear-gradient(135deg, #4a8fe0, #6b5bd2 55%, #f07c5a); }

.side-card { display: flex; gap: 14px; align-items: center; background: var(--card); border: 1px solid var(--line); border-radius: 18px; padding: 16px; margin-bottom: 12px;
  box-shadow: var(--shadow); border-top: 5px solid; }
.side-av { flex: 0 0 60px; width: 60px; height: 60px; border-radius: 50%; overflow: hidden; }
.side-av image { width: 100%; height: 100%; display: block; }
.side-info { flex: 1; min-width: 0; }
.side-who { font-size: 13px; font-weight: 600; }
.side-pain { font-family: var(--serif); font-size: 17px; font-weight: 900; margin: 4px 0; }
.side-grow { font-size: 15px; font-weight: 700; margin-bottom: 4px; }

.story-card { background: var(--card); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; margin-bottom: 16px; box-shadow: var(--shadow); }
.story-cover { position: relative; height: 197px; overflow: hidden; }
.cover-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.cover-chars { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; justify-content: center; align-items: flex-end; }
.cover-char { width: 140px; height: 266px; margin: 0 -6px; transform: translateY(32%); filter: drop-shadow(0 4px 8px rgba(0,0,0,.35)); flex-shrink: 0; }
.cover-badge { position: absolute; top: 10px; left: 10px; background: #f2c14e; color: #3a2a00; font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 999px; }
.story-info { padding: 14px 16px 16px; }
.blurb { line-height: 1.7; margin: 4px 0 12px; font-size: 14px; }
.story-actions { display: flex; flex-wrap: wrap; gap: 8px; }

.route-card { border-left: 6px solid; }
.rtag { display: inline-block; font-size: 12px; padding: 2px 8px; border-radius: 6px; margin-bottom: 8px; }
.dots { margin-top: 10px; }
.coming-grid { display: flex; flex-direction: column; gap: 10px; }

.mute { position: fixed; right: 14px; z-index: 60; width: 42px; height: 42px; border-radius: 50%; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,.15);
  font-size: 18px; display: flex; align-items: center; justify-content: center; }
